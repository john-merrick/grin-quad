# SEC EDGAR identity — required for `distval ingest` and `distval normalise`
# Must be your email address (SEC fair-access policy).
EDGAR_IDENTITY=your@email.com

# FRED API key — required for live macro assumptions in `distval value`
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: equity risk premium override (decimal, default 0.05)
# FRED has no direct ERP series; override here if you disagree with the default.
# FRED_ERP=0.05

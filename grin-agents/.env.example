# Copy to .env (gitignored). Real environment variables override these.
# Prefer 1Password references (op://vault/item/field): grinos resolves them with `op read` at
# startup, so no secret is stored on disk. Check with: grinos notion-check

# Notion — an internal integration with access to the LongGamma databases.
# https://www.notion.so/profile/integrations → New integration → copy the secret,
# then on each database (Valuation Log, Research Notes, Companies, Agent Registry): ••• → Connections → add it.
NOTION_TOKEN=op://Dev-Secrets/notion-alpha-agent-key/credential

# Telegram — @BotFather → /newbot → token; your numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# SEC EDGAR identity, sent as the User-Agent (SEC fair-access policy): a name and an email.
# Same variable distval uses. Without it grinos falls back to a generic agent and warns.
EDGAR_IDENTITY=

# VoiceStudio backend (default shown).
VOICESTUDIO_URL=http://127.0.0.1:3900

# Ledger home and HMAC key (defaults shown). Keep the key out of synced folders.
# GRINOS_HOME=/Users/you/grin-quad/grin-agents/var
# GRINOS_KEY_FILE=/Users/you/.config/grinos/ledger.key
